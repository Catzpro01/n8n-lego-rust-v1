{
  "name": "n8n-lego",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "n8n lego \u2014 workflow automation: the real n8n editor UI served by the LEGO execution engine",
  "license": "SEE LICENSE IN LICENSE.md",
  "engines": {
    "node": ">=22.18.0"
  },
  "main": "src/server.mjs",
  "exports": {
    ".": "./src/server.mjs",
    "./package.json": "./package.json"
  },
  "bin": {
    "n8n-lego": "bin/n8n-lego.mjs"
  },
  "files": [
    "bin/",
    "src/",
    "scripts/",
    "data/",
    "vendor/",
    "README.md",
    "LICENSE.md"
  ],
  "scripts": {
    "start": "node bin/n8n-lego.mjs start",
    "dev": "node --watch src/server.mjs",
    "catalog": "node scripts/fetch-n8n-catalog.mjs && node scripts/fetch-n8n-roles.mjs",
    "test": "node --test test/*.test.mjs",
    "doctor": "node bin/n8n-lego.mjs doctor",
    "prepublishOnly": "node --test test/*.test.mjs && node bin/n8n-lego.mjs version"
  },
  "keywords": [
    "n8n",
    "workflow",
    "automation",
    "no-code",
    "low-code",
    "workflow-automation",
    "n8n-lego"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Catzpro01/n8n-rust-v.4.git",
    "directory": "apps/n8n-lego"
  },
  "homepage": "https://github.com/Catzpro01/n8n-rust-v.4/tree/main/apps/n8n-lego#readme",
  "bugs": {
    "url": "https://github.com/Catzpro01/n8n-rust-v.4/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "os": [
    "linux"
  ],
  "dependencies": {
    "n8n-editor-ui": "2.9.4"
  }
}
