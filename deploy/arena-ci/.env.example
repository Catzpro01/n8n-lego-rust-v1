# Host directories exposed to containers. Do not point these at C:\, C:\Users, Desktop, Documents, or a whole drive.
ARENA_GATEWAY_HOST_DIR=C:/arena-ci/gateway
ARENA_DATA_HOST_DIR=C:/arena-ci/data
CLOUDFLARED_HOST_DIR=C:/arena-ci/cloudflared

# Pin a verified cloudflared image digest before production use.
CLOUDFLARED_IMAGE=cloudflare/cloudflared:latest

# Secret files are local-only and must never be committed.
GITHUB_WEBHOOK_SECRET_FILE=./secrets/github_webhook_secret.txt
GITHUB_PAT_FILE=./secrets/github_pat.txt
