  "description": "$json = json of the CURRENT input item (connectionInputData[itemIndex]). Also plain values, string interpolation and typed returns.",
  "probes": [
    {
      "name": "plain string (no '=' prefix) is returned as-is",
      "value": "hello"
    },
    {
      "name": "$json.a item 0",
      "value": "={{ $json.a }}"
    },
    {
      "name": "$json.a item 1",
      "value": "={{ $json.a }}",
      "itemIndex": 1
    },
    {
      "name": "string interpolation",
      "value": "=Value: {{ $json.a }}!"
    },
    {
      "name": "two expressions concatenate to string",
      "value": "={{ $json.a }}-{{ $json.a }}"
    },
    {
      "name": "single expression keeps number type",
      "value": "={{ $json.a + 1 }}"
    },
    {
      "name": "single expression returns object",
      "value": "={{ $json }}"
    },
    {
      "name": "object inside text becomes [object Object]",
      "value": "=x {{ $json }}"
    },
    {
      "name": "boolean",
      "value": "={{ $json.a > 15 }}"
    },
    {
      "name": "null",
      "value": "={{ null }}"
    },
    {
      "name": "$data alias of $json",
      "value": "={{ $data.a }}"
    },
    {
      "name": "$json out of range item index",
      "value": "={{ $json.a }}",
      "itemIndex": 5
    },
    {
      "name": "$json with empty input",
      "value": "={{ $json.a }}",
