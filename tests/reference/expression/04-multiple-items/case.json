    },
    {
      "name": "$('FalseBranch').item not connected upstream",
      "value": "={{ $('FalseBranch').item }}"
    },
    {
      "name": "$jmespath over $input.all()",
      "value": "={{ $jmespath($input.all(), '[].json.n') }}"
