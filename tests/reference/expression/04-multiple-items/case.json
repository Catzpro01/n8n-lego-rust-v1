      "name": "$('IF').all(1) explicit other branch",
      "value": "={{ $('IF').all(1).map(i => i.json.n) }}"
    },
    {
      "name": "$('IF').first(1).json.n",
      "value": "={{ $('IF').first(1).json.n }}"
    },
    {
      "name": "$('IF').all(2) branch missing",
      "value": "={{ $('IF').all(2) }}"
    },
    {
      "name": "$node['IF'].json.n item 0 via graph output index",
