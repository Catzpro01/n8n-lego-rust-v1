  "description": "Missing properties resolve to undefined (or empty string inside text); unknown nodes / unexecuted nodes / null runExecutionData throw ExpressionError; syntax errors throw ApplicationError('invalid syntax'); calling a non-function returns undefined (evaluator swallows TypeError on backend).",
  "probes": [
    {
      "name": "$json.missing",
      "value": "={{ $json.missing }}"
    },
    {
      "name": "$json.missing.deep (optional chaining by proxy)",
      "value": "={{ $json.missing.deep }}"
    },
    {
      "name": "missing inside text -> empty",
      "value": "=v={{ $json.missing }}"
    },
    {
      "name": "$json.a.notAFunction()",
      "value": "={{ $json.a.notAFunction() }}"
    },
    {
      "name": "syntax error",
      "value": "={{ $json. }}"
    },
    {
      "name": "undefined variable",
      "value": "={{ notDefined }}"
    },
    {
      "name": "$('Start').first().json.missing",
      "value": "={{ $('Start').first().json.missing }}"
    },
    {
      "name": "$vars without provider",
      "value": "={{ $vars.x }}"
    },
    {
      "name": "$env access denied (no provider)",
      "value": "={{ $env.HOME }}"
    },
    {
      "name": "constructor access blocked",
      "value": "={{ ''.constructor }}"
    },
    {
      "name": "$binary when item has none",
      "value": "={{ $binary }}"
    },
    {
      "name": "runExecutionData null: $json still works from input",
      "value": "={{ $json.a }}",
      "_runDataNull": true
    }
  ]
