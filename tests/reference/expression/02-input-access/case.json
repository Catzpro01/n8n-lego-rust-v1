      "value": "={{ $input.last().json.a }}"
    },
    {
      "name": "$input.all().length",
      "value": "={{ $input.all().length }}"
    },
    {
      "name": "$input.all() map",
      "value": "={{ $input.all().map(i => i.json.a) }}"
    },
    {
      "name": "$input.first(1) rejects arguments",
      "value": "={{ $input.first(1) }}"
    },
    {
      "name": "$input.params (params of previous node)",
      "value": "={{ $input.params }}"
    },
    {
      "name": "$input.item with empty input",
      "value": "={{ $input.item }}",
      "connectionInputData": []
    },
    {
      "name": "$input.params without executeData",
      "value": "={{ $input.params }}",
      "executeData": null
    },
    {
      "name": "$input.item.pairedItem visible",
      "value": "={{ $input.item.pairedItem }}",
      "itemIndex": 1
    },
    {
      "name": "$thisItem alias",
      "value": "={{ $thisItem.json.a }}",
      "itemIndex": 1
    },
    {
      "name": "$itemIndex / $position",
      "value": "={{ [$itemIndex, $position] }}",
      "itemIndex": 2
    },
    {
      "name": "$prevNode",
      "value": "={{ $prevNode }}"
    }
  ]
