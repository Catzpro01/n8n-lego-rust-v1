          "data",
          "id",
          "isGlobal",
          "isManaged",
          "isResolvable",
          "name",
          "resolvableAllowFallback",
          "resolverId",
          "scopes",
          "type",
          "updatedAt"
        ],
        "dataFieldPresent": true,
        "type": "httpHeaderAuth"
      },
      "sideEffect": "credentials_entity.data = base64(\"Salted__\"+salt+aes-256-cbc(...)); shared_credentials(owner)"
    },
    "getWithoutData": {
      "input": "GET /rest/credentials/:id",
      "expected": {
        "status": 200,
        "hasData": false,
        "keys": [
          "createdAt",
          "id",
          "isGlobal",
          "isManaged",
          "isResolvable",
          "name",
          "resolvableAllowFallback",
          "resolverId",
          "scopes",
          "type",
          "updatedAt"
        ]
      }
