# ==========================================
# n8n Rust v4 Monorepo Git Ignore Policy
# ==========================================

# Dependencies & Build Artefacts
node_modules/
target/
dist/
*.tsbuildinfo
__pycache__/

# Environment & Secret Files (Rule: Never commit credentials)
.env
.env.*
!.env.example

# Runtime Databases & Local Data (Rule: Runtime state is strictly isolated from git)
*.db
*.db-journal
*.sqlite
*.sqlite3
*.sqlite-wal
*.sqlite-shm
*.node

# Instance Data Directories (Runtime directories for 5677, 5678, 5680 instances)
# Each instance stores state locally in data/ but is never checked into git
data/
!data/
data/*
!data/lego/
data/lego/*
!data/lego/.gitkeep
!data/rust/
data/rust/*
!data/rust/.gitkeep
!data/reference/
data/reference/*
!data/reference/.gitkeep
!data/test/
data/test/*
!data/test/.gitkeep

# Application Bundled Static Data Exceptions
!apps/n8n-lego/data/
apps/n8n-lego/data/*
!apps/n8n-lego/data/roles.json
!apps/n8n-lego/data/api-key-scopes.json
!apps/n8n-lego/data/public-api-openapi.json

# Local Logs & Temporary Directories
logs/
*.log
tmp/
.runtime/
.runtime-ts/
state/

# System & OS Files
.DS_Store
Thumbs.db

# Arena Runtime State
.arena/run/
.arena/worker_logs/
.arena/dispatch/
.arena/results/
.arena/processed/
.arena/gateway_tokens.json
.arena/workforce-state/

# Reference Upstream Noise
reference/**/dist/
reference/**/.turbo/
reference/**/coverage/

# Local Scratch & Temporary Files
*.rs.new
*.tmp
generate_nodes.js
lokasi-file-dan-port-n8n.txt
n8n-wsl
universal-test-workflow.json
sync_all_3_workflows.mjs
test_all_instances.mjs
check-users.mjs
check_wf_*.mjs
update_rust_official.mjs
/n8n lego/
/n8n-rust/
runtime_registry.rs
docs/architecture.md

# Local Archive of loose files
_archive/
.playwright-mcp/
