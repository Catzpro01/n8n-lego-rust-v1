# ==========================================
# n8n Rust v4 Monorepo Git Ignore Policy
# ==========================================

# Dependencies & Build Artefacts
node_modules/
target/
dist/
*.tsbuildinfo
__pycache__/

# Environment & Secret Files (Rule: Never commit credentials)
.env
.env.*
!.env.example

# Runtime Databases & Local Data (Rule: Runtime state is strictly isolated from git)
*.db
*.db-journal
*.sqlite
*.sqlite3
*.sqlite-wal
*.sqlite-shm
*.node

# Instance Data Directories (Runtime directories for 5677, 5678, 5680 instances)
# Each instance stores state locally in data/ but is never checked into git
data/
!data/
data/*
!data/lego/
data/lego/*
!data/lego/.gitkeep
!data/rust/
data/rust/*
!data/rust/.gitkeep
!data/reference/
data/reference/*
!data/reference/.gitkeep
!data/test/
data/test/*
!data/test/.gitkeep

# Application Bundled Static Data Exceptions
!apps/n8n-lego/data/
apps/n8n-lego/data/*
!apps/n8n-lego/data/roles.json
!apps/n8n-lego/data/api-key-scopes.json
!apps/n8n-lego/data/public-api-openapi.json

# Local Logs & Temporary Directories
logs/
*.log
tmp/
.runtime/
.runtime-ts/
state/

# System & OS Files
.DS_Store
Thumbs.db

# Arena Runtime State
.arena/run/
.arena/worker_logs/
.arena/dispatch/
.arena/results/
.arena/processed/
.arena/gateway_tokens.json
.arena/workforce-state/

# Reference Upstream Noise
reference/**/dist/
reference/**/.turbo/
reference/**/coverage/

# Local Scratch, Migration Scripts & Temporary Files (Ignore from clean monorepo)
*.rs.new
code_node*.rs
cron_node.rs
crypto_node*.rs
dynamic_integration_node.rs
execute_workflow_node.rs
function_item_node.rs
http_request_node.rs
if_node*.rs
manual_trigger_node.rs
merge_node.rs
mod_full.rs
noop_node.rs
respond_webhook_node.rs
schedule_trigger_node.rs
server.rs
set_node.rs
split_node.rs
switch_node.rs
traits_full.rs
wait_node.rs
webhook_node.rs
generate_nodes.js
lokasi-file-dan-port-n8n.txt
n8n-wsl
universal-test-workflow.json
sync_all_3_workflows.mjs
test_all_instances.mjs
check-users.mjs
check_wf_*.mjs
update_rust_official.mjs
/n8n lego/
/n8n-rust/
runtime_registry.rs
docs/architecture.md

# Process tracking
.pids.json
*.pids.json
