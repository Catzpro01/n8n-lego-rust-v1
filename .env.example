# ==============================================================================
# n8n Rust v4 Multi-Instance Monorepo Configuration (.env.example)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. n8n Lego Frontend / UI Adapter (apps/n8n-lego)
# ------------------------------------------------------------------------------
N8N_LEGO_PORT=5677
N8N_LEGO_HOST=0.0.0.0
N8N_LEGO_USER_FOLDER=data/lego
N8N_LEGO_OWNER_EMAIL=admin@example.com
N8N_LEGO_OWNER_PASSWORD=adminpassword123
N8N_LEGO_LOG_LEVEL=info

# ------------------------------------------------------------------------------
# 2. n8n Rust Execution Engine / Backend (apps/n8n-rust)
# ------------------------------------------------------------------------------
N8N_RUST_PORT=5678
N8N_RUST_HOST=0.0.0.0
N8N_RUST_DATA_DIR=data/rust
DATABASE_URL=sqlite://data/rust/n8n.sqlite
NODE_EXECUTION_MODE=real

# ------------------------------------------------------------------------------
# 3. Official Upstream n8n Reference / Truth Oracle (apps/n8n-reference)
# ------------------------------------------------------------------------------
N8N_REFERENCE_PORT=5680
N8N_REFERENCE_HOST=0.0.0.0
N8N_REFERENCE_USER_FOLDER=data/reference
N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS=true
N8N_DIAGNOSTICS_ENABLED=false
N8N_HIRING_BANNER_ENABLED=false
N8N_VERSION_NOTIFICATIONS_ENABLED=false

# ------------------------------------------------------------------------------
# 4. Compatibility Testing & Diff Oracle Configuration
# ------------------------------------------------------------------------------
COMPATIBILITY_ORACLE_URL=http://localhost:5680
COMPATIBILITY_CANDIDATE_URL=http://localhost:5678
