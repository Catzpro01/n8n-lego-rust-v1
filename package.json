{
  "name": "n8n-lego-rust-v1",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "n8n Lego frontend, Rust execution backend, and official n8n reference monorepo",
  "scripts": {
    "start": "node scripts/start-all.mjs",
    "start:lego": "node apps/n8n-lego/bin/n8n-lego.mjs start",
    "start:rust": "cargo run --manifest-path apps/n8n-rust/Cargo.toml",
    "start:reference": "node apps/n8n-reference/index.mjs",
    "test:crates": "cargo test --workspace",
    "check:crates": "cargo check --workspace",
    "check:rust": "cargo check --manifest-path apps/n8n-rust/Cargo.toml"
  },
  "keywords": [
    "n8n",
    "rust",
    "lego",
    "workflow",
    "automation",
    "monorepo"
  ],
  "author": "Catzpro01",
  "license": "Apache-2.0"
}
