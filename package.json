{
  "name": "n8n-rust-v4",
  "version": "0.4.0",
  "private": true,
  "description": "n8n 2.9.4 anatomy → contract → reference runtime → LEGO isolation → (later) Rust replacement",
  "scripts": {
    "setup:reference": "bash scripts/setup-reference-runtime.sh",
    "verify": "node tools/workflow-isolation-gate.mjs",
    "verify:fast": "node tools/workflow-isolation-gate.mjs --skip-live",
    "isolation:map": "node tools/workflow-boundary-map.mjs --json packages/workflow-lego/manifest/boundary-map.json --md docs/isolation/workflow-dependency-map.md",
    "isolation:check": "node tools/workflow-boundary-map.mjs --check && node tools/workflow-kernel-conformance.mjs --check && node tools/workflow-port-surface.mjs --check && node tools/workflow-reference-manifest.mjs --check",
    "isolation:extract": "node tools/workflow-isolation-extract.mjs",
    "frontend-lego:test": "node --test packages/frontend-lego/test/*.test.mjs",
    "workflow-lego:build": "npm --prefix packages/workflow-lego run build",
    "workflow-lego:test": "bash scripts/run-lego-tests.sh",
    "runtime:start": "node apps/n8n-ts/src/server.ts",
    "runtime:dev": "node --watch apps/n8n-ts/src/server.ts",
    "runtime:typecheck": "npm --prefix apps/n8n-ts run typecheck",
    "runtime:test": "node --test \"tests/runtime/*.test.mjs\"",
    "runtime:gate": "bash tests/integration/runtime_gate.sh",
    "runtime:smoke": "node tests/runtime/helpers/smoke.mjs",
    "lego:install": "npm --prefix apps/n8n-lego install && node apps/n8n-lego/bin/n8n-lego.mjs catalog",
    "lego:start": "node apps/n8n-lego/bin/n8n-lego.mjs start",
    "lego:dev": "node --watch apps/n8n-lego/src/server.mjs",
    "lego:doctor": "node apps/n8n-lego/bin/n8n-lego.mjs doctor",
    "lego:catalog": "node apps/n8n-lego/bin/n8n-lego.mjs catalog",
    "lego:test": "node --test \"apps/n8n-lego/test/*.test.mjs\"",
    "lego:arch": "node tools/lego/architecture-gate.mjs",
    "lego:arch:selftest": "node tools/lego/architecture-gate.mjs --selftest",
    "lego:capabilities": "node tools/lego/capability-conformance.mjs",
    "lego:scaleout": "node tools/lego/scale-out-readiness.mjs",
    "lego:gate": "npm run lego:arch && npm run lego:arch:selftest && npm run lego:foundation && npm run lego:foundation:selftest && npm run lego:capabilities && npm run lego:scaleout && npm run lego:ai:check && npm run lego:test && npm run frontend-lego:test",
    "lego:pack": "bash scripts/release.sh --npm-only",
    "start": "npm run lego:start",
    "lego:smoke": "node tests/e2e/lego-smoke.mjs",
    "lego:foundation": "node tools/lego/foundation-gate.mjs",
    "lego:foundation:selftest": "node tools/lego/foundation-gate.mjs --selftest",
    "lego:impact": "node tools/lego/impact-graph.mjs",
    "lego:plan": "node tools/lego/impact-graph.mjs --plan",
    "lego:ai": "node tools/lego/ai-pack.mjs",
    "lego:ai:check": "node tools/lego/ai-pack.mjs --check"
  }
}
